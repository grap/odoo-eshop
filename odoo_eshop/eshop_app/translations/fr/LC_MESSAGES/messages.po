#: controllers/controller_account.py:237
#, python-format
msgid ""
"The '%(email)s' field is already used.Please ask your seller to fix the "
"problem."
msgstr ""
"L'email '%(email)s' est déjà utilisé. Veuillez demander à votre vendeur "
"de corriger le problème."

